# --- General ---
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
# --- Base de datos (valores de desarrollo local; cambiarlos fuera de local) ---
POSTGRES_USER=lumenza
POSTGRES_PASSWORD=change_me_local
POSTGRES_DB=lumenza
DATABASE_URL=postgres://lumenza:change_me_local@localhost:5432/lumenza
# --- Sesiones ---
SESSION_SECRET=generate_a_long_random_string
# --- Almacenamiento S3 (RustFS en local, Amazon S3 en producción; mismo código) ---
S3_BUCKET=lumenza-media
S3_REGION=us-east-1
# RustFS local (puerto 9100); dejar vacío para AWS S3 real
S3_ENDPOINT=http://localhost:9100
# En local: define valores propios (mín. 8 y 16 caracteres). En AWS: credenciales IAM / rol.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# --- Google OAuth (Google Cloud Console) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# --- reCAPTCHA ---
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# --- Correo (verificación/recuperación) ---
SMTP_URL=smtp://localhost:1025
MAIL_FROM=LUMENZA <no-reply@lumenza.local>
# --- MFA TOTP: clave de cifrado de secretos (32 bytes en base64), DISTINTA de SESSION_SECRET ---
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Sin esta clave el MFA queda deshabilitado (no hay clave por defecto). Obligatoria en producción.
MFA_ENCRYPTION_KEY=
