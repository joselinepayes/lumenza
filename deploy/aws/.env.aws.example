# LUMENZA — variables de producción para AWS EC2.
# Copia a `.env` (en /opt/lumenza/deploy/aws/.env) y rellénalo. NUNCA subas el .env al repositorio.
# `./lumenza.sh secrets` genera automáticamente POSTGRES_PASSWORD, SESSION_SECRET y MFA_ENCRYPTION_KEY aleatorios.

# --- Acceso público -----------------------------------------------------------
# Origen público EXACTO (esquema + host, sin barra final). Debe coincidir con lo que escribe el usuario en el navegador:
# se usa para CORS, protección CSRF por Origin y los enlaces de los correos.
#   Prueba inicial sin dominio:  http://<IP_PUBLICA_ELASTICA>        (requiere COOKIE_SECURE=false, ver abajo)
#   Definitivo con dominio:      https://lumenza.tudominio.com
PUBLIC_URL=http://REEMPLAZAR
# Nombre de dominio (o `_` si todavía no hay dominio). Obligatorio cuando TLS_MODE=on.
SERVER_NAME=_
# off = solo HTTP (prueba inicial)  ·  on = HTTPS con certificado Let's Encrypt (requiere dominio y certificado emitido)
TLS_MODE=off

# --- Cookies / integraciones --------------------------------------------------
# true (recomendado y obligatorio en el estado final). Poner false SOLO mientras se prueba por HTTP sin dominio:
# con false la API arranca con una advertencia y las cookies de sesión viajan sin cifrar.
COOKIE_SECURE=false
# true = permite arrancar sin SMTP_URL ni reCAPTCHA (etapa previa a tener esas credenciales; esas funciones quedan inactivas).
# El estado final de entrega debe ser false con las tres variables definidas.
ALLOW_MISSING_INTEGRATIONS=true

# --- PostgreSQL (el contenedor NO publica puertos) -----------------------------
POSTGRES_USER=lumenza
POSTGRES_DB=lumenza
POSTGRES_PASSWORD=CAMBIAR

# --- Secretos de la aplicación -------------------------------------------------
# Generados por `./lumenza.sh secrets` (openssl rand). SESSION_SECRET y MFA_ENCRYPTION_KEY deben ser DISTINTOS entre sí.
SESSION_SECRET=CAMBIAR
MFA_ENCRYPTION_KEY=CAMBIAR

# --- Amazon S3 (credenciales por rol IAM de la instancia: NO añadir claves AWS aquí) ---
S3_BUCKET=REEMPLAZAR_NOMBRE_DEL_BUCKET
S3_REGION=us-east-2

# --- Integraciones externas OBLIGATORIAS antes de la entrega final (vacías = inactivas) ---
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# https://TU_DOMINIO/api/auth/google/callback  (debe estar registrada en Google Cloud Console)
GOOGLE_REDIRECT_URI=
# Proveedor SMTP real (p. ej. Amazon SES SMTP): smtps://usuario:clave@email-smtp.us-east-2.amazonaws.com:465
SMTP_URL=
MAIL_FROM=LUMENZA <no-reply@tudominio.com>

# --- Versión de las imágenes (etiqueta) ---------------------------------------
LUMENZA_VERSION=local
